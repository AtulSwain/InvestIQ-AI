FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ANTHROPIC_API_KEY=
# Browser origins allowed to call the API (comma-separated)
INVESTIQ_ALLOWED_ORIGINS=https://atulswain.github.io,http://localhost:8000
